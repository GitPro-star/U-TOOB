# For local development only. Set a long random SECRET_KEY.
SECRET_KEY=replace-with-a-random-secret
# Local test default; Render deployment uses PostgreSQL.
DATABASE_URL=sqlite:///utoob.db
STORAGE_BACKEND=local
# Uploaded files are saved to instance/uploads locally.
# For Render-hosted videos, configure Cloudflare R2 and set STORAGE_BACKEND=r2.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
